# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
/.angular/cache

# Portable JDK downloaded locally to run @openapitools/openapi-generator-cli (no system Java in
# this dev environment) -- never committed, see scripts/generate-client.mjs.
/.tools

# openapi-generator-cli's own version manifest / config cache -- generator bookkeeping, not part
# of the actual generated client; written both at the repo root (the CLI's own cache) and inside
# projects/shared/src/lib/api/generated/ (per-generation metadata), hence unanchored.
.openapi-generator/
.openapi-generator-ignore

# Node
/node_modules
npm-debug.log
yarn-error.log
node_modules/

# Logs
logs
*.log

# IDEs and editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
*.launch
.settings/

